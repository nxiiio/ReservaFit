# Copy this file to .env (git-ignored) and fill in the blanks.
# `docker compose` reads .env automatically, and Vite reads the VITE_* values for `pnpm dev`.
# None of these are secrets: they are public Azure app registration identifiers.

# ---------- Frontend (build time: after changing them run `docker compose up --build`) ----------
# Client ID of the ReservaFit-Frontend app registration
VITE_AZURE_CLIENT_ID=
# API scope: api://<client ID of the ReservaFit-API app registration>/access_as_user
VITE_API_SCOPE=
# Must be a SPA redirect URI registered in Azure. Default: http://localhost:${FRONTEND_PORT}
# VITE_AZURE_REDIRECT_URI=http://localhost:5173
# Backend URL as the browser sees it. Default: http://localhost:${BACKEND_PORT}
# VITE_API_BASE_URL=http://localhost:8080

# ---------- Backend (runtime) ----------
# Client ID of the ReservaFit-API app registration (the audience of the access tokens)
AZURE_API_CLIENT_ID=
# Tenant that issues the tokens: the personal-accounts ("consumers") tenant GUID is the default
# AZURE_API_TENANT_ID=9188040d-6c67-4c5b-b112-36a304b66dad
# Comma-separated browser origins allowed by CORS, no spaces. Default: http://localhost:${FRONTEND_PORT}
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Host ports (optional) ----------
# If you change FRONTEND_PORT, register http://localhost:<port> as a SPA redirect URI in Azure.
# FRONTEND_PORT=5173
# BACKEND_PORT=8080
